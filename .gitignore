# Entorno virtual y cache de Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Configuraciones y carpetas de agentes
.agents/
.antigravity/

# Datos pesados y audios descargados (NO subir a Git)
datos/crudos/*
!datos/crudos/.gitkeep
datos/medios/*
!datos/medios/.gitkeep
datos/procesados/*
!datos/procesados/.gitkeep

# Modelos entrenados pesados y logs
modelos_guardados/*.joblib
modelos_guardados/*.pkl
!modelos_guardados/.gitkeep
logs/*.log
!logs/.gitkeep
.env
.DS_Store
Thumbs.db

# Archivos de planeacion interna local (no subir a GitHub)
plan_maestro_detallado.md
plan_*.md
